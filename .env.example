# Example configuration for the AdLinkFly resolver API.
# Copy to `.env` and adjust. DO NOT commit real secrets.

# ----- Application -----
ENVIRONMENT=production            # development | staging | production
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_JSON=true                     # structured JSON logs (recommended in prod)

# ----- Authentication -----
# Comma-separated API keys. REQUIRED in production (service fails closed if
# REQUIRE_API_KEY is true and none are set).
API_KEYS=replace-with-a-strong-key
REQUIRE_API_KEY=true
API_KEY_HEADER=X-API-Key

# ----- Rate limiting (per API key / client IP, per process) -----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ----- HTTP client (cloudscraper) -----
HTTP_CONNECT_TIMEOUT=10
HTTP_READ_TIMEOUT=20
MAX_REDIRECTS=10
MAX_RESPONSE_BYTES=3000000
# Wall-clock cap for the whole cloudscraper phase; on timeout, fall back to the
# browser so a slow/hanging upstream cannot consume the entire request budget.
HTTP_PHASE_TIMEOUT=20
# cloudscraper internal challenge-solving delay (seconds).
CLOUDSCRAPER_DELAY=3
# USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) ...

# ----- Browser (Playwright / Chromium) -----
ENABLE_BROWSER=true
BROWSER_HEADLESS=true
BROWSER_NAVIGATION_TIMEOUT_MS=20000
BROWSER_MAX_STEPS=8
BROWSER_COUNTDOWN_MAX_SECONDS=20
BROWSER_SLOW_MO_MS=0
# Short bounded wait (ms) to let dynamic content settle after an action
# (replaces open-ended networkidle waits, which never settle on ad-heavy pages).
BROWSER_SETTLE_TIMEOUT_MS=2500
# Safety margin (seconds) reserved so the browser returns a structured result
# just before the overall RESOLVE_TOTAL_TIMEOUT would fire.
BROWSER_TIME_MARGIN_SECONDS=2

# ----- Resolver -----
RESOLVE_TOTAL_TIMEOUT=60
MAX_CONCURRENT_RESOLVES=10
MAX_CONCURRENT_BROWSERS=2
# Comma-separated list of authorised shortener domains you are permitted to automate.
SUPPORTED_DOMAINS=arolinks.com

# ----- Security / network -----
# NEVER enable in production reachable by untrusted callers: relaxes SSRF checks
# so loopback/private targets (e.g. a local test server) are allowed.
ALLOW_PRIVATE_NETWORKS=false
MAX_URL_LENGTH=2048

# ----- CORS (optional) -----
# Comma-separated list of allowed origins; leave empty to disable CORS.
# CORS_ALLOW_ORIGINS=https://your-frontend.example
